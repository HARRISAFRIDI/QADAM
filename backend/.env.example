ENVIRONMENT=development            # development | preview | production
# Runtime: Supabase TRANSACTION pooler (port 6543, IPv4). URL-encode special chars in the password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Migrations/scripts only: SESSION pooler (port 5432). Not needed on Vercel.
DATABASE_URL_MIGRATIONS=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DB_POOL_SIZE=5                     # 0 = NullPool
SECRET_KEY=<at least 32 random characters: python -c "import secrets;print(secrets.token_urlsafe(48))">
CORS_ALLOWED_ORIGINS=              # empty when the frontend proxies /api/v1 (recommended)
# Optional - enables paper / answer-sheet / image uploads
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
